@@ -0,0 +1,59 @@
+package org.jenkinsci.plugins.workflow.cps.determinism;
+
+import java.io.File;
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.TreeMap;
+
+/**
+ * Durable, mutable state of one {@code deterministicReplay} block in one build.
+ * Persisted under {@code <build>/replay-tapes/.sessions/<sessionId>.xml} after every mutation
+ * so that recording and verification resume where they left off after a controller restart.
+ * All access must be synchronized on the instance.
+ */
+final class SessionState {
+
+    /** Reference from a flow node id to the tape row it produced/consumed (makes interception idempotent). */
+    static final class EntryRef {
+        final String stream;
+        final int seq;
+
+        EntryRef(String stream, int seq) {
+            this.stream = stream;
+            this.seq = seq;
+        }
+    }
+
+    final String sessionId;
+    final DeterminismMode mode;
+    final String tapePath;
+    /** VERIFY only: number of the build whose tape is being replayed. */
+    int baselineBuild;
+
+    /** RECORD: tape under construction. VERIFY: tape loaded from the baseline build. */
+    ExecutionTape tape;
+
+    /** VERIFY: next expected position per stream. */
+    final Map<String, Integer> cursors = new TreeMap<>();
+    /** Flow node id → tape row. */
+    final Map<String, EntryRef> nodes = new HashMap<>();
+    final List<String> violations = new ArrayList<>();
+    int verified;
+    int replayed;
+    boolean finished;
+
+    transient File file;
+
+    SessionState(String sessionId, DeterminismMode mode, String tapePath) {
+        this.sessionId = sessionId;
+        this.mode = mode;
+        this.tapePath = tapePath;
+    }
+
+    void save() throws IOException {
+        DeterminismEngine.write(file, this);
+    }
+}
diff --git a/plugin/src/main/java/org/jenkinsci/plugins/workflow/cps/determinism/TapeEntry.java b/plugin/src/main/java/org/jenkinsci/plugins/workflow/cps/determinism/TapeEntry.java
new file mode 100644
index 0000000..3816085
--- /dev/null
+++ b/plugin/src/main/java/org/jenkinsci/plugins/workflow/cps/determinism/TapeEntry.java
@@ -0,0 +1,105 @@
+package org.jenkinsci.plugins.workflow.cps.determinism;
+
+import edu.umd.cs.findbugs.annotations.CheckForNull;
+
+/**
+ * One row of an {@link ExecutionTape}: a single step invocation observed on a given stream.
+ */
+public final class TapeEntry {
+
+    public enum Status {
+        /** The step started but its outcome has not been observed (yet). */
+        PENDING,
+        SUCCESS,
+        FAILURE
+    }
+
+    /** Position of this entry within its stream (0-based). */
+    private final int seq;
+    /** {@code StepDescriptor#getFunctionName()} of the step, e.g. {@code sh}. */
+    private final String stepId;
+    /** Canonical, deterministic rendering of the step arguments. */
+    private final String arguments;
+    /** SHA-256 of {@link #arguments}; used for matching. */
+    private final String argumentsDigest;
+    /** True for block-scoped steps (bodies, {@code parallel}, {@code load}); those are validated but never replayed. */
+    private final boolean block;
+
+    private Status status = Status.PENDING;
+    private Object value;
+    private Throwable error;
+    private boolean replayable = true;
+    private String notReplayableReason;
+
+    TapeEntry(int seq, String stepId, String arguments, String argumentsDigest, boolean block) {
+        this.seq = seq;
+        this.stepId = stepId;
+        this.arguments = arguments;
+        this.argumentsDigest = argumentsDigest;
+        this.block = block;
+    }
+
+    public int getSeq() {
+        return seq;
+    }
+
+    public String getStepId() {
+        return stepId;
+    }
+
+    public String getArguments() {
+        return arguments;
+    }
+
+    public String getArgumentsDigest() {
+        return argumentsDigest;
+    }
+
+    public boolean isBlock() {
+        return block;
+    }
+
+    public Status getStatus() {
+        return status;
+    }
+
+    public @CheckForNull Object getValue() {
+        return value;
+    }
+
+    public @CheckForNull Throwable getError() {
+        return error;
+    }
+
+    public boolean isReplayable() {
+        return replayable;
+    }
+
+    public @CheckForNull String getNotReplayableReason() {
+        return notReplayableReason;
+    }
+
+    void succeeded(Object value) {
+        this.status = Status.SUCCESS;
+        this.value = value;
+        this.error = null;
+    }
+
+    void failed(Throwable error) {
+        this.status = Status.FAILURE;
+        this.value = null;
+        this.error = error;
+    }
+
+    void markNotReplayable(String reason) {
+        this.replayable = false;
+        this.notReplayableReason = reason;
+        this.value = null;
+        this.error = null;
+    }
+
+    @Override
+    public String toString() {
+        return "#" + seq + " " + stepId + "(" + arguments + ") -> " + status;
+    }
+}
