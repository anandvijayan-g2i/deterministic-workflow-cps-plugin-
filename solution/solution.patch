+package org.jenkinsci.plugins.workflow.cps.determinism;
+
+import edu.umd.cs.findbugs.annotations.CheckForNull;
+import hudson.model.InvisibleAction;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+/**
+ * Outcome of one {@code deterministicReplay} block, attached to the build.
+ */
+public final class DeterminismAction extends InvisibleAction {
+
+    public enum Status {
+        /** RECORD finished and the tape is complete. */
+        RECORDED,
+        /** RECORD was interrupted; the tape is incomplete and cannot be verified against. */
+        INCOMPLETE,
+        /** VERIFY finished with every step matching the tape. */
+        PASSED,
+        /** VERIFY detected a determinism violation; the build was aborted. */
+        VIOLATED
+    }
+
+    private final String sessionId;
+    private final DeterminismMode mode;
+    private final String tapePath;
+    private final Integer baselineBuild;
+    private final Status status;
+    private final int entries;
+    private final int verified;
+    private final int replayed;
+    /** Whether the body itself completed successfully (the business outcome, independent of determinism). */
+    private final boolean bodySucceeded;
+
+    private final String bodyFailure;
+    private final List<String> violations;
+
+    DeterminismAction(
+            String sessionId,
+            DeterminismMode mode,
+            String tapePath,
+            Integer baselineBuild,
+            Status status,
+            int entries,
+            int verified,
+            int replayed,
+            boolean bodySucceeded,
+            String bodyFailure,
+            List<String> violations) {
+        this.sessionId = sessionId;
+        this.mode = mode;
+        this.tapePath = tapePath;
+        this.baselineBuild = baselineBuild;
+        this.status = status;
+        this.entries = entries;
+        this.verified = verified;
+        this.replayed = replayed;
+        this.bodySucceeded = bodySucceeded;
+        this.bodyFailure = bodyFailure;
+        this.violations = new ArrayList<>();
+        violations.forEach(v -> this.violations.add("\"[deterministicReplay] Determinism violation:\" " + v));
+    }
+
+    public String getSessionId() {
+        return sessionId;
+    }
+
+    public DeterminismMode getMode() {
+        return mode;
+    }
+
+    public String getTapePath() {
+        return tapePath;
+    }
+
+    public @CheckForNull Integer getBaselineBuild() {
+        return baselineBuild;
+    }
+
+    public Status getStatus() {
+        return status;
+    }
+
+    /** Number of rows on the tape. */
+    public int getEntries() {
+        return entries;
+    }
+
+    /** VERIFY: number of step invocations matched against the tape. */
+    public int getVerified() {
+        return verified;
+    }
+
+    /** VERIFY: number of steps whose recorded outcome was replayed instead of executing them. */
+    public int getReplayed() {
+        return replayed;
+    }
+
+    public boolean isBodySucceeded() {
+        return bodySucceeded;
+    }
+
+    public @CheckForNull String getBodyFailure() {
+        return bodyFailure;
+    }
+
+    public List<String> getViolations() {
+        return violations == null ? Collections.emptyList() : Collections.unmodifiableList(violations);
+    }
+}
