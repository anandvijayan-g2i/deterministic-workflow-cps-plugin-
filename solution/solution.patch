@@ -0,0 +1,35 @@
+package org.jenkinsci.plugins.workflow.cps.determinism;
+
+import java.io.Serializable;
+
+/**
+ * Context object injected into the body of a {@code deterministicReplay} block.
+ * Every step invoked inside the body can find its owning session via
+ * {@code StepContext.get(ReplaySessionHandle.class)}; parallel branches inherit it.
+ * It is deliberately tiny: all mutable state lives in {@link SessionState} on disk.
+ */
+public final class ReplaySessionHandle implements Serializable {
+
+    private static final long serialVersionUID = 1L;
+
+    private final String sessionId;
+    private final DeterminismMode mode;
+
+    ReplaySessionHandle(String sessionId, DeterminismMode mode) {
+        this.sessionId = sessionId;
+        this.mode = mode;
+    }
+
+    public String getSessionId() {
+        return sessionId;
+    }
+
+    public DeterminismMode getMode() {
+        return mode;
+    }
+
+    @Override
+    public String toString() {
+        return "ReplaySession[" + sessionId + "," + mode + "]";
+    }
+}
