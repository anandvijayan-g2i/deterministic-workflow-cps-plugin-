@@ -0,0 +1,26 @@
+package org.jenkinsci.plugins.workflow.cps.determinism;
+
+import edu.umd.cs.findbugs.annotations.NonNull;
+import java.util.Locale;
+
+/**
+ * Operating mode of a {@link DeterministicReplayStep} block.
+ */
+public enum DeterminismMode {
+    /** Execute every step normally and capture an ordered execution tape. */
+    RECORD,
+    /** Do not execute side-effecting steps; validate them against a tape and replay recorded outcomes. */
+    VERIFY;
+
+    public static @NonNull DeterminismMode parse(String value) {
+        if (value == null || value.trim().isEmpty()) {
+            throw new IllegalArgumentException("mode must be one of 'record' or 'verify'");
+        }
+        try {
+            return valueOf(value.trim().toUpperCase(Locale.ROOT));
+        } catch (IllegalArgumentException x) {
+            throw new IllegalArgumentException("Unknown deterministicReplay mode '" + value
+                    + "'; expected 'record' or 'verify'");
+        }
+    }
+}
