+package org.jenkinsci.plugins.workflow.cps.determinism;
+
+import edu.umd.cs.findbugs.annotations.CheckForNull;
+import edu.umd.cs.findbugs.annotations.NonNull;
+import hudson.AbortException;
+import hudson.XmlFile;
+import hudson.model.Job;
+import hudson.model.Result;
+import hudson.model.Run;
+import hudson.model.TaskListener;
+import hudson.util.XStream2;
+import java.io.File;
+import java.io.IOException;
+import java.io.PrintStream;
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.Deque;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.logging.Level;
+import java.util.logging.Logger;
+import java.util.regex.Pattern;
+import org.jenkinsci.plugins.workflow.actions.ThreadNameAction;
+import org.jenkinsci.plugins.workflow.cps.steps.LoadStep;
+import org.jenkinsci.plugins.workflow.cps.steps.ParallelStep;
+import org.jenkinsci.plugins.workflow.flow.FlowExecutionOwner;
+import org.jenkinsci.plugins.workflow.graph.BlockStartNode;
+import org.jenkinsci.plugins.workflow.graph.FlowNode;
+import org.jenkinsci.plugins.workflow.steps.FlowInterruptedException;
+import org.jenkinsci.plugins.workflow.steps.Step;
+import org.jenkinsci.plugins.workflow.steps.StepContext;
+import org.jenkinsci.plugins.workflow.steps.StepDescriptor;
+import org.kohsuke.accmod.Restricted;
+import org.kohsuke.accmod.restrictions.NoExternalUse;
+
+/**
+ * Deterministic execution recording and replay verification engine.
+ *
+ * <h2>Record</h2>
+ * Every step started inside a {@code deterministicReplay(mode: 'record')} block is appended to the
+ * tape stream of its CPS branch <em>before</em> it starts (via {@link DeterminismStepListener}), and
+ * its outcome (return value or exception) is filled in when its {@code StepContext} completes
+ * (via {@link #stepCompleted}). The state is written to disk after each event.
+ *
+ * <h2>Verify</h2>
+ * Every step started inside a {@code deterministicReplay(mode: 'verify')} block is compared against
+ * the next expected row of its stream. On a match the recorded outcome is delivered to the
+ * {@code StepContext} immediately, so {@code DSL} never calls {@code Step.start} and no side effect
+ * happens; block-scoped steps and explicitly pass-through steps are validated but executed.
+ * On a mismatch the build is aborted.
+ *
+ * <h2>Concurrency and durability</h2>
+ * Tape rows are keyed by the branch path of the invoking CPS thread, so parallel branches
+ * never compete for cursors. Mutations are synchronized per session and persisted
+ * atomically; interception is idempotent per flow node id, so work resumed after a restart
+ * neither duplicates nor skips rows.
+ */
+@Restricted(NoExternalUse.class)
+public final class DeterminismEngine {
+
+    private static final Logger LOGGER = Logger.getLogger(DeterminismEngine.class.getName());
+
+    static final XStream2 XSTREAM = new XStream2();
+
+    static {
+        XSTREAM.alias("execution-tape", ExecutionTape.class);
+        XSTREAM.alias("tape-entry", TapeEntry.class);
+        XSTREAM.alias("determinism-session", SessionState.class);
+        XSTREAM.alias("entry-ref", SessionState.EntryRef.class);
+    }
+
+    /** Directory, relative to the build root, holding tapes. */
+    public static final String TAPE_DIR = "replay-tapes";
+
+    private static final String SESSION_DIR = ".sessions";
+
+    private static final Pattern SAFE_TAPE_PATH = Pattern.compile("[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*");
+
+    static final String LOG_PREFIX = "[deterministicReplay] ";
+
+    /** Live sessions, keyed by absolute state file path. */
+    private static final Map<String, SessionState> SESSIONS = new ConcurrentHashMap<>();
+
+    private DeterminismEngine() {}
+
+    // ------------------------------------------------------------------ paths
+
+    static @NonNull String validateTapePath(String tapePath) {
+        if (tapePath == null
+                || !SAFE_TAPE_PATH.matcher(tapePath).matches()
+                || tapePath.startsWith(SESSION_DIR)
+                || tapePath.contains("..")) {
+            throw new IllegalArgumentException("tapePath must be a relative path made of [A-Za-z0-9._-] segments"
+                    + " (no '..'), resolved inside the build directory: " + tapePath);
+        }
+        return tapePath;
+    }
+
+    /** Location of a tape inside a given build. */
+    public static @NonNull File tapeFile(@NonNull Run<?, ?> run, @NonNull String tapePath) {
+        return tapeFile(run.getRootDir(), tapePath);
+    }
+
+    static @NonNull File tapeFile(@NonNull File buildDir, @NonNull String tapePath) {
+        return new File(new File(buildDir, TAPE_DIR), validateTapePath(tapePath));
+    }
+
+    static @NonNull File stateFile(@NonNull File buildDir, @NonNull String sessionId) {
+        return new File(new File(new File(buildDir, TAPE_DIR), SESSION_DIR), "session-" + sessionId + ".xml");
+    }
+
+    static void write(@NonNull File file, @NonNull Object o) throws IOException {
+        File dir = file.getParentFile();
+        if (dir != null && !dir.isDirectory() && !dir.mkdirs() && !dir.isDirectory()) {
+            throw new IOException("Could not create " + dir);
+        }
+        new XmlFile(XSTREAM, file).write(o);
+    }
+
+    // ------------------------------------------------------------------ session lifecycle
+
+    /** Called from {@code DeterministicReplayStep.Execution#start}. */
+    static @NonNull SessionState open(
+            @NonNull Run<?, ?> run,
+            @NonNull String sessionId,
+            @NonNull DeterminismMode mode,
+            @NonNull String tapePath,
+            @CheckForNull Integer baselineBuild,
+            @NonNull TaskListener listener)
+            throws IOException {
+        File stateFile = stateFile(run.getRootDir(), sessionId);
+        SessionState st = new SessionState(sessionId, mode, tapePath);
+        st.file = stateFile;
+        if (mode == DeterminismMode.RECORD) {
+            st.tape = new ExecutionTape(run.getParent().getFullName(), run.getNumber());
+            listener.getLogger().println(LOG_PREFIX + "Recording execution tape to " + tapePath);
+        } else {
+            Run<?, ?> baseline = findBaseline(run, tapePath, baselineBuild);
+            File source = tapeFile(baseline, tapePath);
+            ExecutionTape tape = ExecutionTape.load(source);
+            if (!tape.isComplete()) {
+                throw new AbortException("Execution tape " + tapePath + " of " + baseline.getFullDisplayName()
+                        + " is incomplete; the recording did not finish");
+            }
+            st.tape = tape;
+            st.baselineBuild = baseline.getNumber();
+            listener.getLogger()
+                    .println(LOG_PREFIX + "Verifying against tape " + tapePath + " of "
+                            + baseline.getFullDisplayName() + " (" + tape.size() + " entries)");
+        }
+        st.save();
+        SESSIONS.put(stateFile.getAbsolutePath(), st);
+        return st;
+    }
+
+    private static @NonNull Run<?, ?> findBaseline(
+            @NonNull Run<?, ?> run, @NonNull String tapePath, @CheckForNull Integer baselineBuild)
+            throws AbortException {
+        Job<?, ?> job = run.getParent();
+        if (baselineBuild != null) {
+            Run<?, ?> b = job.getBuildByNumber(baselineBuild);
+            if (b == null || b == run) {
+                throw new AbortException("Baseline build #" + baselineBuild + " not found");
+            }
+            if (!tapeFile(b, tapePath).isFile()) {
+                throw new AbortException("Baseline build #" + baselineBuild + " has no execution tape " + tapePath);
+            }
+            return b;
+        }
+        for (Run<?, ?> b = run.getPreviousBuild(); b != null; b = b.getPreviousBuild()) {
+            if (tapeFile(b, tapePath).isFile()) {
+                return b;
+            }
+        }
+        throw new AbortException("No previous build of " + job.getFullName() + " recorded execution tape " + tapePath);
+    }
+
+    /** Looks up (loading from disk after a restart if necessary) the state of a session. */
+    static @NonNull SessionState session(@NonNull File buildDir, @NonNull String sessionId) throws IOException {
+        File f = stateFile(buildDir, sessionId);
+        String key = f.getAbsolutePath();
+        SessionState st = SESSIONS.get(key);
+        if (st != null) {
+            return st;
+        }
+        synchronized (SESSIONS) {
+            st = SESSIONS.get(key);
+            if (st == null) {
+                if (!f.isFile()) {
+                    throw new IOException("Missing deterministicReplay session state " + f);
+                }
+                st = (SessionState) new XmlFile(XSTREAM, f).read();
+                st.file = f;
+                SESSIONS.put(key, st);
+                LOGGER.log(Level.FINE, "Reloaded determinism session {0} from {1}", new Object[] {sessionId, f});
+            }
+            return st;
+        }
+    }
+
+    // ------------------------------------------------------------------ interception
+
+    /**
+     * Called before a step inside a session starts. In VERIFY mode this may complete
+     * {@code context}, which tells {@code DSL} to skip {@code Step.start}.
+     */
+    static void intercept(
+            @NonNull ReplaySessionHandle handle,
+            @NonNull Step step,
+            @NonNull StepContext context,
+            @NonNull List<String> passthrough)
+            throws IOException, InterruptedException {
+        Run<?, ?> run = context.get(Run.class);
+        FlowNode node = context.get(FlowNode.class);
+        if (run == null || node == null) {
+            return;
+        }
+        SessionState st = session(run.getRootDir(), handle.getSessionId());
+        StepDescriptor d = step.getDescriptor();
+        String stepId = d.getFunctionName();
+        boolean block = isBlock(step, d, context);
+        String stream = streamKey(node, handle.getSessionId());
+        String args = ArgumentCanonicalizer.canonicalize(step);
+        String digest = ArgumentCanonicalizer.digest(args);
+
+        if (handle.getMode() == DeterminismMode.RECORD) {
+            synchronized (st) {
+                if (st.finished || st.nodes.containsKey(node.getId())) {
+                    return; // already recorded (e.g. re-entered after a restart)
+                }
+                List<TapeEntry> s = st.tape.streamForAppend(stream);
+                TapeEntry e = new TapeEntry(s.size(), stepId, args, digest, block);
+                s.add(e);
+                st.nodes.put(node.getId(), new SessionState.EntryRef(stream, e.getSeq()));
+                st.save();
+            }
+            return;
+        }
+
+        // VERIFY
+        String violation = null;
+        TapeEntry replay = null;
+        synchronized (st) {
+            if (st.finished) {
+                return;
+            }
+            if (!st.violations.isEmpty()) {
+                violation = st.violations.get(0);
+            } else {
+                SessionState.EntryRef ref = st.nodes.get(node.getId());
+                TapeEntry expected;
+                if (ref != null) {
+                    expected = st.tape.entry(ref.stream, ref.seq); // idempotent re-entry after restart
+                } else {
+                    int cursor = st.cursors.getOrDefault(stream, 0);
+                    expected = st.tape.entry(stream, cursor);
+                    if (expected == null) {
+                        violation = "unexpected step '" + stepId + "' (" + args + ") at position " + cursor
+                                + " of stream '" + stream + "': the recorded tape has no more entries there";
+                    } else if (!expected.getStepId().equals(stepId)) {
+                        violation = "expected step '" + expected.getStepId() + "' but got '" + stepId
+                                + "' at position " + cursor + " of stream '" + stream + "'";
+                    } else if (!expected.getArgumentsDigest().equals(digest)) {
+                        violation = "arguments of step '" + stepId + "' at position " + cursor + " of stream '"
+                                + stream + "' differ from the recording; expected " + expected.getArguments()
+                                + " but got " + args;
+                    } else {
+                        st.cursors.put(stream, cursor + 1);
+                        st.nodes.put(node.getId(), new SessionState.EntryRef(stream, cursor));
+                        st.verified++;
+                    }
+                }
+                if (violation == null && expected != null && !expected.isBlock() && !passthrough.contains(stepId)) {
+                    if (!expected.isReplayable()) {
+                        violation = "step '" + stepId + "' at position " + expected.getSeq() + " of stream '"
+                                + stream + "' cannot be replayed: " + expected.getNotReplayableReason();
+                    } else if (expected.getStatus() == TapeEntry.Status.PENDING) {
+                        violation = "step '" + stepId + "' at position " + expected.getSeq() + " of stream '"
+                                + stream + "' has no recorded outcome";
+                    } else {
+                        replay = expected;
+                        if (ref == null) {
+                            st.replayed++;
+                        }
+                    }
+                }
+                if (violation != null) {
+                    st.violations.add(violation);
+                }
+            }
+            st.save();
+        }
+
+        TaskListener listener = context.get(TaskListener.class);
+        PrintStream log = listener != null ? listener.getLogger() : null;
+        if (violation != null) {
+            if (log != null) {
+                log.println(LOG_PREFIX + "Determinism violation: " + violation);
+            }
+            context.onFailure(abort(violation));
+        } else if (replay != null) {
+            if (log != null) {
+                log.println(LOG_PREFIX + "Replayed '" + stepId + "' #" + replay.getSeq() + " of stream '" + stream
+                        + "' from tape (" + replay.getStatus() + "); side effects suppressed");
+            }
+            if (replay.getStatus() == TapeEntry.Status.FAILURE) {
+                context.onFailure(replay.getError());
+            } else {
+                context.onSuccess(replay.getValue());
+            }
+        }
+    }
+
+    private static boolean isBlock(Step step, StepDescriptor d, StepContext context) {
+        return context.hasBody()
+                || d.takesImplicitBlockArgument()
+                || step instanceof ParallelStep
+                || d instanceof LoadStep.DescriptorImpl;
+    }
+
+    /**
+     * Identifies the CPS branch execution path of a node, relative to the session block:
+     * {@code main} for the block's own thread, {@code main/a} inside branch {@code a} of a
+     * {@code parallel}, {@code main/a/x} for nested parallels, and so on.
+     */
+    static @NonNull String streamKey(@NonNull FlowNode node, @NonNull String sessionId) {
+        Deque<String> names = new ArrayDeque<>();
+        for (BlockStartNode b : node.iterateEnclosingBlocks()) {
+            if (b.getId().equals(sessionId)) {
+                break;
+            }
+            ThreadNameAction t = b.getPersistentAction(ThreadNameAction.class);
+            if (t != null) {
+                names.addFirst(t.getThreadName().replace("%", "%25").replace("/", "%2F"));
+            }
+        }
+        StringBuilder b = new StringBuilder(ExecutionTape.MAIN_STREAM);
+        for (String n : names) {
+            b.append('/').append(n);
+        }
+        return b.toString();
+    }
+
+    static @NonNull FlowInterruptedException abort(@NonNull String violation) {
+        return new FlowInterruptedException(Result.ABORTED, true, new DeterminismViolation(violation));
+    }
+
+    // ------------------------------------------------------------------ completion (RECORD)
+
+    /**
+     * Called by {@code CpsStepContext} the first time a step's outcome is set, before the CPS
+     * thread is resumed. Captures the outcome of steps recorded by an active RECORD session.
+     */
+    public static void stepCompleted(
+            @NonNull FlowExecutionOwner owner, @NonNull String nodeId, Object value, Throwable error) {
+        if (SESSIONS.isEmpty()) {
+            return;
+        }
+        String prefix;
+        try {
+            prefix = new File(new File(owner.getRootDir(), TAPE_DIR), SESSION_DIR).getAbsolutePath()
+                    + File.separator;
+        } catch (IOException x) {
+            return;
+        }
+        for (Map.Entry<String, SessionState> e : SESSIONS.entrySet()) {
+            if (!e.getKey().startsWith(prefix)) {
+                continue;
+            }
+            SessionState st = e.getValue();
+            if (st.mode != DeterminismMode.RECORD) {
+                continue;
+            }
+            synchronized (st) {
+                SessionState.EntryRef ref = st.nodes.get(nodeId);
+                if (ref == null || st.finished) {
+                    continue;
+                }
+                TapeEntry entry = st.tape.entry(ref.stream, ref.seq);
+                if (entry == null || entry.getStatus() != TapeEntry.Status.PENDING) {
+                    continue;
+                }
+                if (error != null) {
+                    entry.failed(error);
+                } else {
+                    entry.succeeded(value);
+                }
+                String problem = checkReplayable(entry);
+                if (problem != null) {
+                    entry.markNotReplayable(problem);
+                }
+                try {
+                    st.save();
+                } catch (IOException | RuntimeException x) {
+                    LOGGER.log(Level.WARNING, "Could not persist outcome of node " + nodeId, x);
+                }
+            }
+        }
+    }
+
+    /** Returns null if the outcome survives a round trip through the tape format. */
+    private static @CheckForNull String checkReplayable(TapeEntry entry) {
+        Object payload = entry.getStatus() == TapeEntry.Status.FAILURE ? entry.getError() : entry.getValue();
+        if (payload == null) {
+            return null;
+        }
+        try {
+            XSTREAM.fromXML(XSTREAM.toXML(payload));
+            return null;
+        } catch (RuntimeException | LinkageError x) {
+            return "outcome of type " + payload.getClass().getName() + " cannot be serialized: " + x;
+        }
+    }
+
+    // ------------------------------------------------------------------ finish
+
+    /**
+     * Called when the block body completes. Finalizes the tape (RECORD) or checks that every
+     * recorded row was consumed (VERIFY), attaches a {@link DeterminismAction} and returns the
+     * violation to abort the build with, if any.
+     */
+    static @CheckForNull FlowInterruptedException finish(
+            @NonNull Run<?, ?> run,
+            @NonNull String sessionId,
+            @CheckForNull Throwable bodyFailure,
+            @NonNull TaskListener listener)
+            throws IOException {
+        SessionState st = session(run.getRootDir(), sessionId);
+        DeterminismAction action;
+        List<String> violations;
+        synchronized (st) {
+            boolean bodyOk = bodyFailure == null;
+            String bodyMessage = bodyFailure == null ? null : String.valueOf(bodyFailure);
+            if (st.mode == DeterminismMode.RECORD) {
+                boolean interrupted = bodyFailure instanceof FlowInterruptedException;
+                st.tape.setComplete(!interrupted);
+                st.tape.save(tapeFile(run.getRootDir(), st.tapePath));
+                action = new DeterminismAction(
+                        st.sessionId,
+                        st.mode,
+                        st.tapePath,
+                        null,
+                        interrupted ? DeterminismAction.Status.INCOMPLETE : DeterminismAction.Status.RECORDED,
+                        st.tape.size(),
+                        0,
+                        0,
+                        bodyOk,
+                        bodyMessage,
+                        st.violations);
+                listener.getLogger()
+                        .println(LOG_PREFIX + "Recorded " + st.tape.size() + " step(s) to " + st.tapePath
+                                + (interrupted ? " (incomplete: build was interrupted)" : ""));
+            } else {
+                if (st.violations.isEmpty()) {
+                    for (Map.Entry<String, List<TapeEntry>> e :
+                            st.tape.getStreams().entrySet()) {
+                        int consumed = st.cursors.getOrDefault(e.getKey(), 0);
+                        if (consumed < e.getValue().size()) {
+                            TapeEntry next = e.getValue().get(consumed);
+                            st.violations.add("stream '" + e.getKey() + "' ended after " + consumed
+                                    + " step(s) but the tape recorded " + e.getValue().size() + "; next expected step '"
+                                    + next.getStepId() + "' (" + next.getArguments() + ") never ran");
+                        }
+                    }
+                }
+                boolean violated = !st.violations.isEmpty();
+                action = new DeterminismAction(
+                        st.sessionId,
+                        st.mode,
+                        st.tapePath,
+                        st.baselineBuild,
+                        violated ? DeterminismAction.Status.VIOLATED : DeterminismAction.Status.PASSED,
+                        st.tape.size(),
+                        st.verified,
+                        st.replayed,
+                        bodyOk,
+                        bodyMessage,
+                        st.violations);
+                listener.getLogger()
+                        .println(LOG_PREFIX + (violated ? "Verification FAILED: " + st.violations : "Verification passed")
+                                + " (" + st.verified + " verified, " + st.replayed + " replayed, body "
+                                + (bodyOk ? "succeeded" : "failed") + ")");
+                write(new File(tapeFile(run.getRootDir(), st.tapePath).getPath() + ".verify-" + st.sessionId + ".xml"),
+                        action);
+            }
+            violations = new ArrayList<>(st.violations);
+            st.finished = true;
+            st.save();
+        }
+        SESSIONS.remove(st.file.getAbsolutePath());
+        run.addAction(action);
+        if (!violations.isEmpty()) {
+            run.setResult(Result.ABORTED);
+            return abort(violations.get(0));
+        }
+        return null;
+    }
+
+    /** For tests: drops the in-memory registry, as a controller restart would. */
+    static void forgetAllSessions() {
+        SESSIONS.clear();
+    }
+}
