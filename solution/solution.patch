@@ -0,0 +1,46 @@
+package org.jenkinsci.plugins.workflow.cps.determinism;
+
+import edu.umd.cs.findbugs.annotations.NonNull;
+import hudson.Extension;
+import java.util.logging.Level;
+import java.util.logging.Logger;
+import org.jenkinsci.plugins.workflow.flow.StepListener;
+import org.jenkinsci.plugins.workflow.steps.Step;
+import org.jenkinsci.plugins.workflow.steps.StepContext;
+import org.kohsuke.accmod.Restricted;
+import org.kohsuke.accmod.restrictions.NoExternalUse;
+
+/**
+ * Hooks every step invocation; {@code DSL} calls this after the step is instantiated and its
+ * flow node created, but before {@code Step.start}. If the listener completes the context,
+ * the step is never started.
+ */
+@Extension
+@Restricted(NoExternalUse.class)
+public final class DeterminismStepListener implements StepListener {
+
+    private static final Logger LOGGER = Logger.getLogger(DeterminismStepListener.class.getName());
+
+    @Override
+    public void notifyOfNewStep(@NonNull Step step, @NonNull StepContext context) {
+        if (step instanceof DeterministicReplayStep) {
+            return; // nesting is rejected by the step itself
+        }
+        try {
+            ReplaySessionHandle handle = context.get(ReplaySessionHandle.class);
+            if (handle == null) {
+                return;
+            }
+            PassthroughSteps passthrough = context.get(PassthroughSteps.class);
+            DeterminismEngine.intercept(
+                    handle, step, context, passthrough != null ? passthrough.getStepIds() : java.util.List.of());
+        } catch (InterruptedException x) {
+            Thread.currentThread().interrupt();
+            context.onFailure(x);
+        } catch (Exception x) {
+            // Never let a broken tape silently execute side effects in VERIFY mode.
+            LOGGER.log(Level.WARNING, "deterministicReplay interception failed", x);
+            context.onFailure(x);
+        }
+    }
+}
