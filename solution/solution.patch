+++ b/plugin/src/main/java/org/jenkinsci/plugins/workflow/cps/determinism/DeterministicReplayStep.java
@@ -0,0 +1,212 @@
+package org.jenkinsci.plugins.workflow.cps.determinism;
+
+import edu.umd.cs.findbugs.annotations.CheckForNull;
+import edu.umd.cs.findbugs.annotations.NonNull;
+import hudson.AbortException;
+import hudson.Extension;
+import hudson.model.Run;
+import hudson.model.TaskListener;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Set;
+import java.util.logging.Level;
+import java.util.logging.Logger;
+import org.jenkinsci.plugins.workflow.graph.FlowNode;
+import org.jenkinsci.plugins.workflow.steps.AbstractStepExecutionImpl;
+import org.jenkinsci.plugins.workflow.steps.BodyExecutionCallback;
+import org.jenkinsci.plugins.workflow.steps.FlowInterruptedException;
+import org.jenkinsci.plugins.workflow.steps.Step;
+import org.jenkinsci.plugins.workflow.steps.StepContext;
+import org.jenkinsci.plugins.workflow.steps.StepDescriptor;
+import org.jenkinsci.plugins.workflow.steps.StepExecution;
+import org.kohsuke.stapler.DataBoundConstructor;
+import org.kohsuke.stapler.DataBoundSetter;
+
+/**
+ * {@code deterministicReplay(mode: 'record'|'verify', tapePath: 'name.xml') { … }}
+ * <p>
+ * RECORD runs the body normally and writes an ordered execution tape of every step it runs to
+ * {@code <build dir>/replay-tapes/<tapePath>}. VERIFY loads that tape from a baseline build
+ * (the most recent earlier build that recorded it, or {@code baselineBuild}), and instead of
+ * starting each step validates its id and arguments against the next expected tape row and
+ * resumes the CPS continuation with the recorded outcome. A mismatch aborts the build.
+ */
+public final class DeterministicReplayStep extends Step {
+
+    private final DeterminismMode mode;
+    private final String tapePath;
+    private Integer baselineBuild;
+    private List<String> passthrough = new ArrayList<>();
+
+    @DataBoundConstructor
+    public DeterministicReplayStep(String mode, String tapePath) {
+        this.mode = DeterminismMode.parse(mode);
+        this.tapePath = DeterminismEngine.validateTapePath(tapePath);
+    }
+
+    public String getMode() {
+        return mode.name().toLowerCase(java.util.Locale.ROOT);
+    }
+
+    public String getTapePath() {
+        return tapePath;
+    }
+
+    public @CheckForNull Integer getBaselineBuild() {
+        return baselineBuild;
+    }
+
+    /** VERIFY only: number of the build whose tape to verify against. Defaults to the latest build that recorded it. */
+    @DataBoundSetter
+    public void setBaselineBuild(Integer baselineBuild) {
+        this.baselineBuild = baselineBuild;
+    }
+
+    public List<String> getPassthrough() {
+        return passthrough;
+    }
+
+    /**
+     * VERIFY only: function names of steps (e.g. {@code input}) that are validated against the
+     * tape but executed for real instead of being replayed.
+     */
+    @DataBoundSetter
+    public void setPassthrough(List<String> passthrough) {
+        this.passthrough = passthrough == null ? new ArrayList<>() : new ArrayList<>(passthrough);
+    }
+
+    @Override
+    public StepExecution start(StepContext context) throws Exception {
+        return new Execution(context, mode, tapePath, baselineBuild, passthrough);
+    }
+
+    public static final class Execution extends AbstractStepExecutionImpl {
+
+        private static final long serialVersionUID = 1L;
+
+        private final DeterminismMode mode;
+        private final String tapePath;
+        private final Integer baselineBuild;
+        private final ArrayList<String> passthrough;
+        private String sessionId;
+
+        Execution(
+                StepContext context,
+                DeterminismMode mode,
+                String tapePath,
+                Integer baselineBuild,
+                List<String> passthrough) {
+            super(context);
+            this.mode = mode;
+            this.tapePath = tapePath;
+            this.baselineBuild = baselineBuild;
+            this.passthrough = new ArrayList<>(passthrough);
+        }
+
+        @Override
+        public boolean start() throws Exception {
+            StepContext context = getContext();
+            if (context.get(ReplaySessionHandle.class) != null) {
+                throw new AbortException("deterministicReplay blocks cannot be nested");
+            }
+            Run<?, ?> run = context.get(Run.class);
+            FlowNode node = context.get(FlowNode.class);
+            TaskListener listener = context.get(TaskListener.class);
+            sessionId = node.getId();
+            DeterminismEngine.open(run, sessionId, mode, tapePath, baselineBuild, listener);
+            context.newBodyInvoker()
+                    .withContexts(new ReplaySessionHandle(sessionId, mode), new PassthroughSteps(passthrough))
+                    .withCallback(new Callback(sessionId))
+                    .start();
+            return false;
+        }
+
+        @Override
+        public void onResume() {
+            // Re-register the session after a controller restart before in-flight steps report back.
+            try {
+                Run<?, ?> run = getContext().get(Run.class);
+                if (run != null && sessionId != null) {
+                    DeterminismEngine.session(run.getRootDir(), sessionId);
+                }
+            } catch (Exception x) {
+                Logger.getLogger(Execution.class.getName())
+                        .log(Level.WARNING, "Could not reload deterministicReplay session " + sessionId, x);
+            }
+        }
+
+        @Override
+        public String getStatus() {
+            return mode + " " + tapePath + " (session " + sessionId + ")";
+        }
+    }
+
+    private static final class Callback extends BodyExecutionCallback {
+
+        private static final long serialVersionUID = 1L;
+
+        private final String sessionId;
+
+        Callback(String sessionId) {
+            this.sessionId = sessionId;
+        }
+
+        @Override
+        public void onSuccess(StepContext context, Object result) {
+            complete(context, result, null);
+        }
+
+        @Override
+        public void onFailure(StepContext context, Throwable t) {
+            complete(context, null, t);
+        }
+
+        private void complete(StepContext context, Object result, Throwable failure) {
+            try {
+                Run<?, ?> run = context.get(Run.class);
+                TaskListener listener = context.get(TaskListener.class);
+                FlowInterruptedException violation = DeterminismEngine.finish(run, sessionId, failure, listener);
+                if (violation != null) {
+                    if (failure != null && failure != violation) {
+                        violation.addSuppressed(failure);
+                    }
+                    context.onFailure(violation);
+                } else if (failure != null) {
+                    context.onFailure(failure);
+                } else {
+                    context.onSuccess(result);
+                }
+            } catch (Exception x) {
+                if (failure != null) {
+                    x.addSuppressed(failure);
+                }
+                context.onFailure(x);
+            }
+        }
+    }
+
+    @Extension
+    public static final class DescriptorImpl extends StepDescriptor {
+
+        @Override
+        public String getFunctionName() {
+            return "deterministicReplay";
+        }
+
+        @NonNull
+        @Override
+        public String getDisplayName() {
+            return "Record or verify a deterministic execution tape";
+        }
+
+        @Override
+        public boolean takesImplicitBlockArgument() {
+            return true;
+        }
+
+        @Override
+        public Set<? extends Class<?>> getRequiredContext() {
+            return Set.of(Run.class, FlowNode.class, TaskListener.class);
+        }
+    }
+}
