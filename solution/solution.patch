+package org.jenkinsci.plugins.workflow.cps.determinism;
+
+import edu.umd.cs.findbugs.annotations.NonNull;
+import groovy.lang.Closure;
+import java.lang.reflect.Array;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.Collection;
+import java.util.Map;
+import java.util.TreeMap;
+import org.jenkinsci.plugins.structs.describable.UninstantiatedDescribable;
+import org.jenkinsci.plugins.workflow.steps.Step;
+
+/**
+ * Produces a stable textual representation of step arguments, independent of map ordering
+ * and object identity, so that two invocations with equal arguments compare equal across builds.
+ */
+final class ArgumentCanonicalizer {
+
+    private ArgumentCanonicalizer() {}
+
+    static @NonNull String canonicalize(@NonNull Step step) {
+        Map<String, Object> args;
+        try {
+            args = step.getDescriptor().defineArguments(step);
+        } catch (UnsupportedOperationException | IllegalStateException x) {
+            return "<" + step.getClass().getName() + ">";
+        }
+        StringBuilder b = new StringBuilder();
+        render(args, b, 0);
+        return b.toString();
+    }
+
+    static @NonNull String digest(@NonNull String canonical) {
+        try {
+            byte[] d = MessageDigest.getInstance("SHA-256").digest(canonical.getBytes(StandardCharsets.UTF_8));
+            StringBuilder b = new StringBuilder(d.length * 2);
+            for (byte x : d) {
+                b.append(String.format("%02x", x));
+            }
+            return b.toString();
+        } catch (NoSuchAlgorithmException x) {
+            throw new AssertionError(x);
+        }
+    }
+
+    private static void render(Object o, StringBuilder b, int depth) {
+        if (depth > 32) {
+            b.append("<too deep>");
+            return;
+        }
+        if (o == null) {
+            b.append("null");
+        } else if (o instanceof CharSequence) {
+            b.append('\'').append(o.toString().replace("\\", "\\\\").replace("'", "\\'")).append('\'');
+        } else if (o instanceof Number || o instanceof Boolean || o instanceof Character || o instanceof Enum) {
+            b.append(o);
+        } else if (o instanceof Closure) {
+            b.append("<closure>");
+        } else if (o instanceof UninstantiatedDescribable) {
+            UninstantiatedDescribable ud = (UninstantiatedDescribable) o;
+            b.append(ud.getSymbol() != null ? ud.getSymbol() : ud.getKlass());
+            b.append('(');
+            render(ud.getArguments(), b, depth + 1);
+            b.append(')');
+        } else if (o instanceof Map) {
+            Map<String, Object> sorted = new TreeMap<>();
+            ((Map<?, ?>) o).forEach((k, v) -> sorted.put(String.valueOf(k), v));
+            b.append('[');
+            boolean first = true;
+            for (Map.Entry<String, Object> e : sorted.entrySet()) {
+                if (!first) {
+                    b.append(", ");
+                }
+                first = false;
+                b.append(e.getKey()).append(':');
+                render(e.getValue(), b, depth + 1);
+            }
+            if (sorted.isEmpty()) {
+                b.append(':');
+            }
+            b.append(']');
+        } else if (o instanceof Collection || o.getClass().isArray()) {
+            b.append('[');
+            boolean first = true;
+            if (o instanceof Collection) {
+                for (Object e : (Collection<?>) o) {
+                    if (!first) {
+                        b.append(", ");
+                    }
+                    first = false;
+                    render(e, b, depth + 1);
+                }
+            } else {
+                for (int i = 0; i < Array.getLength(o); i++) {
+                    if (i > 0) {
+                        b.append(", ");
+                    }
+                    render(Array.get(o, i), b, depth + 1);
+                }
+            }
+            b.append(']');
+        } else {
+            b.append('<').append(o.getClass().getName());
+            if (overridesToString(o)) {
+                b.append(':').append(o);
+            }
+            b.append('>');
+        }
+    }
+
+    private static boolean overridesToString(Object o) {
+        try {
+            return o.getClass().getMethod("toString").getDeclaringClass() != Object.class;
+        } catch (NoSuchMethodException x) {
+            return false;
+        }
+    }
+}
