+++ b/plugin/src/main/java/org/jenkinsci/plugins/workflow/cps/determinism/ExecutionTape.java
@@ -0,0 +1,102 @@
+package org.jenkinsci.plugins.workflow.cps.determinism;
+
+import edu.umd.cs.findbugs.annotations.CheckForNull;
+import edu.umd.cs.findbugs.annotations.NonNull;
+import hudson.XmlFile;
+import java.io.File;
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Map;
+import java.util.TreeMap;
+
+/**
+ * Ordered execution table captured by a {@code deterministicReplay(mode: 'record')} block.
+ * <p>
+ * Entries are kept per <em>stream</em>: one stream per CPS branch execution path
+ * ({@code main}, {@code main/branchA}, {@code main/branchA/inner}, …) so that the relative
+ * interleaving of concurrent {@code parallel} branches does not affect verification.
+ */
+public final class ExecutionTape {
+
+    public static final int FORMAT_VERSION = 1;
+
+    public static final String MAIN_STREAM = "main";
+
+    private int formatVersion = FORMAT_VERSION;
+    private String job;
+    private int build;
+    private boolean complete;
+    private final TreeMap<String, List<TapeEntry>> streams = new TreeMap<>();
+
+    ExecutionTape(String job, int build) {
+        this.job = job;
+        this.build = build;
+    }
+
+    public int getFormatVersion() {
+        return formatVersion;
+    }
+
+    public String getJob() {
+        return job;
+    }
+
+    public int getBuild() {
+        return build;
+    }
+
+    /** True once the recording block finished; only complete tapes may be verified against. */
+    public boolean isComplete() {
+        return complete;
+    }
+
+    void setComplete(boolean complete) {
+        this.complete = complete;
+    }
+
+    /** Read-only view of the streams. */
+    public @NonNull Map<String, List<TapeEntry>> getStreams() {
+        Map<String, List<TapeEntry>> copy = new TreeMap<>();
+        streams.forEach((k, v) -> copy.put(k, Collections.unmodifiableList(new ArrayList<>(v))));
+        return Collections.unmodifiableMap(copy);
+    }
+
+    public @NonNull List<TapeEntry> getStream(String key) {
+        List<TapeEntry> s = streams.get(key);
+        return s == null ? Collections.emptyList() : Collections.unmodifiableList(s);
+    }
+
+    public int size() {
+        return streams.values().stream().mapToInt(List::size).sum();
+    }
+
+    @NonNull
+    List<TapeEntry> streamForAppend(String key) {
+        return streams.computeIfAbsent(key, k -> new ArrayList<>());
+    }
+
+    @CheckForNull
+    TapeEntry entry(String stream, int seq) {
+        List<TapeEntry> s = streams.get(stream);
+        return s == null || seq < 0 || seq >= s.size() ? null : s.get(seq);
+    }
+
+    /** Loads a tape written by a recording build. */
+    public static @NonNull ExecutionTape load(@NonNull File file) throws IOException {
+        Object o = new XmlFile(DeterminismEngine.XSTREAM, file).read();
+        if (!(o instanceof ExecutionTape)) {
+            throw new IOException(file + " does not contain an execution tape");
+        }
+        ExecutionTape t = (ExecutionTape) o;
+        if (t.formatVersion != FORMAT_VERSION) {
+            throw new IOException("Unsupported execution tape format " + t.formatVersion + " in " + file);
+        }
+        return t;
+    }
+
+    void save(@NonNull File file) throws IOException {
+        DeterminismEngine.write(file, this);
+    }
+}
